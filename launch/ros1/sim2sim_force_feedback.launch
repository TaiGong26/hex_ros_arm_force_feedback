<launch>
    <!-- simulation arguments -->
    <arg name="viewer" default="true"/>
    <arg name="rviz" default="false"/>

    <!-- sim environment: master (mujoco + rviz, no built-in test ctrl) -->
    <group ns="master">
        <include file="$(find hex_ros_sim_archer_y6)/launch/ros1/sim_archer_y6.launch">
            <arg name="viewer" value="$(arg viewer)"/>
            <arg name="rviz" value="$(arg rviz)"/>
            <arg name="test" value="false"/>
        </include>
    </group>

    <!-- sim environment: slave (mujoco + rviz, no built-in test ctrl) -->
    <group ns="slave">
        <include file="$(find hex_ros_sim_archer_y6)/launch/ros1/sim_archer_y6.launch">
            <arg name="viewer" value="$(arg viewer)"/>
            <arg name="rviz" value="$(arg rviz)"/>
            <arg name="test" value="false"/>
        </include>
    </group>

    <!-- keyboard teleop -->
    <include file="$(find hex_ros_teleop_keyboard)/launch/ros1/teleop_keyboard.launch"/>

    <!-- force feedback control node -->
    <include file="$(find hex_ros_arm_force_feedback)/launch/ros1/arm_force_feedback.launch"/>
</launch>